# Managed by meshly (installed by `meshly init`/`activate`). Do not edit:
# meshly rewrites this file on upgrade. Override with `systemctl edit meshly`.
[Unit]
Description=Meshly WireGuard link
Documentation=https://github.com/nikitakiselev/meshly
# Our nftables table must be loaded after the system ruleset, because
# nftables.service usually starts with "flush ruleset".
After=nftables.service network-pre.target
Wants=network-pre.target
Before=network-online.target
# Restarting/stopping the system firewall restarts/stops meshly; reloading
# it (which may flush our table) re-applies the meshly table. Starting it is
# handled by the drop-in nftables.service.d/50-meshly.conf.
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service
ConditionPathExists=/etc/meshly/meshly.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@EXE@ service start
ExecReload=@EXE@ service reload
ExecStop=@EXE@ service stop
TimeoutStartSec=90
TimeoutStopSec=60
UMask=0077
# Hardening: only CAP_NET_ADMIN, read-only system except meshly state.
# ProtectKernelTunables is off because per-interface sysctls are written
# (net.ipv4.conf.<iface>.*); no global sysctl is changed.
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/etc/meshly -/var/lib/meshly -/run/meshly
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
Also=meshly-check.timer
