# Managed by meshly. Periodic local integrity check: re-applies the meshly
# firewall table if it was removed or modified outside meshly.
[Unit]
Description=Meshly integrity check
Documentation=https://github.com/nikitakiselev/meshly
ConditionPathExists=/etc/meshly/meshly.json
# Only while the link is meant to run: never revives a stopped service.
Requisite=meshly.service
After=meshly.service

[Service]
Type=oneshot
ExecStart=@EXE@ service check
TimeoutStartSec=60
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/etc/meshly -/var/lib/meshly -/run/meshly
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
